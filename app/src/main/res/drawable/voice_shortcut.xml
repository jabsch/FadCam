<?xml version="1.0" encoding="utf-8"?>
<!-- Voice recording shortcut icon: mic glyph on a round red badge, matching the PNG shortcut set. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#E53935" />
            <size android:width="108dp" android:height="108dp" />
        </shape>
    </item>
    <item android:drawable="@drawable/ic_mic_material"
        android:left="30dp" android:top="30dp" android:right="30dp" android:bottom="30dp" />
</layer-list>
