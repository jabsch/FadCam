<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <!-- Fixed Header -->
    <LinearLayout
        android:id="@+id/header_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        android:background="@drawable/header_bar_rounded_bg"
                android:elevation="8dp"
app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <ImageView
            android:id="@+id/back_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="14dp"
            android:layout_marginStart="-12dp"
            android:layout_marginEnd="-12dp"
            android:layout_marginVertical="-12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            android:tint="?attr/colorTopBarContent"/>
        <TextView
            android:id="@+id/header_video"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_video_title"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="?attr/colorTopBarContent"
            android:layout_marginStart="12dp"/>
    </LinearLayout>

    <ScrollView
        android:id="@+id/content_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingBottom="76dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/header_bar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp">

            <!-- Group Card Container -->
            <LinearLayout
                android:id="@+id/group_card_video"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/settings_group_card_bg"

>

            <!-- Pixel optimized mode row: shown only on supported Pixel phones -->
            <LinearLayout
                android:id="@+id/row_pixel_optimized"
                style="@style/SettingsGroupRow"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone">
                <TextView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="16dp"
                    android:fontFamily="@font/materialicons"
                    android:gravity="center"
                    android:text="smartphone"
                    android:textSize="18sp"
                    android:textColor="@android:color/darker_gray" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/setting_pixel_optimized_title"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="?attr/colorHeading"/>
                <TextView
                    android:id="@+id/value_pixel_optimized"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-"
                    android:textColor="@android:color/darker_gray"
                    android:textSize="13sp"/>
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_arrow_right"
                    android:tint="@android:color/darker_gray"/>
            </LinearLayout>
            <View
                android:id="@+id/divider_pixel_optimized"
                style="@style/SettingsDivider"
                android:visibility="gone" />

            <!-- Quick preset row (resolution + fps in one tap): shown with the Pixel row -->
            <LinearLayout
                android:id="@+id/row_recording_preset"
                style="@style/SettingsGroupRow"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone">
                <TextView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="16dp"
                    android:fontFamily="@font/materialicons"
                    android:gravity="center"
                    android:text="tune"
                    android:textSize="18sp"
                    android:textColor="@android:color/darker_gray" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/setting_recording_preset_title"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="?attr/colorHeading"/>
                <TextView
                    android:id="@+id/value_recording_preset"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-"
                    android:textColor="@android:color/darker_gray"
                    android:textSize="13sp"/>
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_arrow_right"
                    android:tint="@android:color/darker_gray"/>
            </LinearLayout>
            <View
                android:id="@+id/divider_recording_preset"
                style="@style/SettingsDivider"
                android:visibility="gone" />

            <!-- Video Stabilization Row (opens bottom sheet) -->
            <LinearLayout
                android:id="@+id/row_video_stabilization"
                style="@style/SettingsGroupRow"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="16dp"
                    android:fontFamily="@font/materialicons"
                    android:gravity="center"
                    android:text="graphic_eq"
                    android:textSize="18sp"
                    android:textColor="@android:color/darker_gray" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/setting_video_stabilization_title"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="?attr/colorHeading"/>
                <TextView
                    android:id="@+id/value_video_stabilization"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-"
                    android:textColor="@android:color/darker_gray"
                    android:textSize="13sp"/>
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_arrow_right"
                    android:tint="@android:color/darker_gray"/>
            </LinearLayout>
            <View style="@style/SettingsDivider" />

            <!-- Preview frame rate while recording (opens bottom sheet) -->
            <LinearLayout
                android:id="@+id/row_preview_fps"
                style="@style/SettingsGroupRow"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="16dp"
                    android:fontFamily="@font/materialicons"
                    android:gravity="center"
                    android:text="visibility"
                    android:textSize="18sp"
                    android:textColor="@android:color/darker_gray" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/setting_preview_fps_title"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="?attr/colorHeading"/>
                <TextView
                    android:id="@+id/value_preview_fps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-"
                    android:textColor="@android:color/darker_gray"
                    android:textSize="13sp"/>
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_arrow_right"
                    android:tint="@android:color/darker_gray"/>
            </LinearLayout>
            <View style="@style/SettingsDivider" />

            <!-- Camera size while only previewing (opens bottom sheet) -->
            <LinearLayout
                android:id="@+id/row_preview_resolution"
                style="@style/SettingsGroupRow"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="16dp"
                    android:fontFamily="@font/materialicons"
                    android:gravity="center"
                    android:text="aspect_ratio"
                    android:textSize="18sp"
                    android:textColor="@android:color/darker_gray" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/setting_preview_resolution_title"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="?attr/colorHeading"/>
                <TextView
                    android:id="@+id/value_preview_resolution"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-"
                    android:textColor="@android:color/darker_gray"
                    android:textSize="13sp"/>
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_arrow_right"
                    android:tint="@android:color/darker_gray"/>
            </LinearLayout>
            <View style="@style/SettingsDivider" />

            <!-- Direct encode: camera straight to the encoder, no watermarks (opens bottom sheet) -->
            <LinearLayout
                android:id="@+id/row_direct_encode"
                style="@style/SettingsGroupRow"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="16dp"
                    android:fontFamily="@font/materialicons"
                    android:gravity="center"
                    android:text="speed"
                    android:textSize="18sp"
                    android:textColor="@android:color/darker_gray" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/setting_direct_encode_title"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="?attr/colorHeading"/>
                <TextView
                    android:id="@+id/value_direct_encode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-"
                    android:textColor="@android:color/darker_gray"
