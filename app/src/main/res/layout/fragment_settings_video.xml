                    android:layout_height="14dp"
                    android:src="@drawable/ic_arrow_right"
                    android:tint="@android:color/darker_gray"/>
            </LinearLayout>
            <View style="@style/SettingsDivider" />

            <!-- Preview letterbox fill (opens bottom sheet) -->
            <LinearLayout
                android:id="@+id/row_preview_bars"
                style="@style/SettingsGroupRow"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="16dp"
                    android:fontFamily="@font/materialicons"
                    android:gravity="center"
                    android:text="crop_free"
                    android:textSize="18sp"
                    android:textColor="@android:color/darker_gray" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/setting_preview_bars_title"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="?attr/colorHeading"/>
                <TextView
                    android:id="@+id/value_preview_bars"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-"
                    android:textColor="@android:color/darker_gray"
                    android:textSize="13sp"/>
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_arrow_right"
                    android:tint="@android:color/darker_gray"/>
            </LinearLayout>
            <View style="@style/SettingsDivider" />

            <!-- Low-light frame rate (opens bottom sheet) -->
            <LinearLayout
                android:id="@+id/row_low_light_fps"
                style="@style/SettingsGroupRow"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="16dp"
                    android:fontFamily="@font/materialicons"
                    android:gravity="center"
                    android:text="nights_stay"
                    android:textSize="18sp"
                    android:textColor="@android:color/darker_gray" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/setting_low_light_fps_title"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="?attr/colorHeading"/>
                <TextView
                    android:id="@+id/value_low_light_fps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-"
                    android:textColor="@android:color/darker_gray"
                    android:textSize="13sp"/>
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_arrow_right"
                    android:tint="@android:color/darker_gray"/>
            </LinearLayout>
            <View style="@style/SettingsDivider" />

            <!-- Heat response (opens bottom sheet) -->
            <LinearLayout
                android:id="@+id/row_heat_response"
                style="@style/SettingsGroupRow"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="16dp"
                    android:fontFamily="@font/materialicons"
                    android:gravity="center"
                    android:text="thermostat"
                    android:textSize="18sp"
                    android:textColor="@android:color/darker_gray" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/setting_heat_response_title"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="?attr/colorHeading"/>
                <TextView
                    android:id="@+id/value_heat_response"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-"
                    android:textColor="@android:color/darker_gray"
                    android:textSize="13sp"/>
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_arrow_right"
                    android:tint="@android:color/darker_gray"/>
            </LinearLayout>
            <View style="@style/SettingsDivider" />

            <!-- Faditor export codec (opens bottom sheet) -->
            <LinearLayout
                android:id="@+id/row_editor_export"
                style="@style/SettingsGroupRow"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="16dp"
                    android:fontFamily="@font/materialicons"
                    android:gravity="center"
                    android:text="movie_edit"
                    android:textSize="18sp"
                    android:textColor="@android:color/darker_gray" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/setting_editor_export_title"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="?attr/colorHeading"/>
                <TextView
                    android:id="@+id/value_editor_export"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-"
                    android:textColor="@android:color/darker_gray"
                    android:textSize="13sp"/>
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_arrow_right"
                    android:tint="@android:color/darker_gray"/>
            </LinearLayout>
            <View style="@style/SettingsDivider" />

            <!-- Camera Selection Row -->
            <LinearLayout
                android:id="@+id/row_camera_type"
                style="@style/SettingsGroupRow">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="16dp"
                    android:src="@drawable/ic_vid_cam"
                    android:tint="@android:color/darker_gray"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/row_camera_title"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="?attr/colorHeading"/>
                <TextView
                    android:id="@+id/value_camera_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-"
                    android:textColor="@android:color/darker_gray"
                    android:textSize="13sp"/>
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_arrow_right"
                    android:tint="@android:color/darker_gray"/>
            </LinearLayout>
            <!-- Helper moved into dialog; reintroduce divider -->
            <View style="@style/SettingsDivider" />

            <!-- Dual Camera Settings Row (visible only when DUAL_PIP selected) -->
            <LinearLayout
                android:id="@+id/row_dual_camera_settings"
                style="@style/SettingsGroupRow"
                android:visibility="gone">
                <TextView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="16dp"
                    android:gravity="center"
                    android:text="picture_in_picture"
                    android:textSize="20sp"
                    android:textColor="@android:color/darker_gray"
                    android:fontFamily="@font/materialicons" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dual_cam_settings_row_title"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:textColor="?attr/colorHeading"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dual_cam_settings_row_subtitle"
                        android:textColor="@android:color/darker_gray"
                        android:textSize="12sp"/>
                </LinearLayout>
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_arrow_right"
                    android:tint="@android:color/darker_gray"/>
            </LinearLayout>
            <View
                android:id="@+id/divider_dual_camera_settings"
                style="@style/SettingsDivider"
                android:visibility="gone" />

            <!-- Lens Row -->
            <LinearLayout
                android:id="@+id/row_lens"
                style="@style/SettingsGroupRow">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="16dp"
                    android:src="@drawable/ic_lens"
                    android:tint="@android:color/darker_gray"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/row_lens_title"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="?attr/colorHeading"/>
                <TextView
                    android:id="@+id/value_lens"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-"
                    android:textColor="@android:color/darker_gray"
                    android:textSize="13sp"/>
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_arrow_right"
                    android:tint="@android:color/darker_gray"/>
            </LinearLayout>
            <View style="@style/SettingsDivider" />

            <!-- Resolution Row -->
            <LinearLayout
                android:id="@+id/row_resolution"
                style="@style/SettingsGroupRow">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="16dp"
                    android:src="@drawable/ic_grid"
                    android:tint="@android:color/darker_gray"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/row_resolution_title"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="?attr/colorHeading"/>
                <TextView
                    android:id="@+id/value_resolution"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-"
                    android:textColor="@android:color/darker_gray"
                    android:textSize="13sp"/>
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_arrow_right"
                    android:tint="@android:color/darker_gray"/>
            </LinearLayout>
            <View style="@style/SettingsDivider" />

            <!-- Frame Rate Row -->
            <LinearLayout
                android:id="@+id/row_framerate"
                style="@style/SettingsGroupRow">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="16dp"
                    android:src="@drawable/ic_fps"
                    android:tint="@android:color/darker_gray"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/row_frame_rate_title"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="?attr/colorHeading"/>
                <TextView
                    android:id="@+id/value_framerate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-"
                    android:textColor="@android:color/darker_gray"
                    android:textSize="13sp"/>
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_arrow_right"
                    android:tint="@android:color/darker_gray"/>
            </LinearLayout>
            <View style="@style/SettingsDivider" />

            <!-- Codec Selection -->
            <LinearLayout
                android:id="@+id/row_codec"
                style="@style/SettingsGroupRow">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="16dp"
                    android:src="@drawable/ic_avc"
                    android:tint="@android:color/darker_gray"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/row_codec_title"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="?attr/colorHeading"/>
                <TextView
                    android:id="@+id/value_codec"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-"
                    android:textColor="@android:color/darker_gray"
                    android:textSize="13sp"/>
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_arrow_right"
                    android:tint="@android:color/darker_gray"/>
            </LinearLayout>
            <View style="@style/SettingsDivider" />

            <!-- Bitrate Row -->
            <LinearLayout
                android:id="@+id/row_bitrate"
                style="@style/SettingsGroupRow">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="16dp"
                    android:src="@drawable/ic_bitrate"
                    android:tint="@android:color/darker_gray"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/row_bitrate_title"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="?attr/colorHeading"/>
                <TextView
                    android:id="@+id/value_bitrate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-"
                    android:textColor="@android:color/darker_gray"
                    android:textSize="13sp"/>
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_arrow_right"
