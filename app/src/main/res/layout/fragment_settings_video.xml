            </LinearLayout>
            <!-- Divider removed -->

            <View style="@style/SettingsDivider" />

            <!-- Zoom Ratio Row -->
            <LinearLayout
                android:id="@+id/row_zoom_ratio"
                style="@style/SettingsGroupRow">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="16dp"
                    android:src="@drawable/ic_zoom"
                    android:tint="@android:color/darker_gray"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/row_zoom_ratio_title"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="?attr/colorHeading"/>
                <TextView
                    android:id="@+id/value_zoom_ratio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-"
                    android:textColor="@android:color/darker_gray"
                    android:textSize="13sp"/>
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_arrow_right"
                    android:tint="@android:color/darker_gray"/>
            </LinearLayout>
            <View style="@style/SettingsDivider" />

            <!-- Maximum Recording Duration Row -->
            <LinearLayout
                android:id="@+id/row_maximum_recording_duration"
                style="@style/SettingsGroupRow">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="16dp"
                    android:src="@drawable/hourglass_top_24px"
                    app:tint="@android:color/darker_gray"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/maximum_recording_duration_title"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="?attr/colorHeading"/>
                <TextView
                    android:id="@+id/value_maximum_recording_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/maximum_recording_duration_no_limit"
                    android:textColor="@android:color/darker_gray"
                    android:textSize="13sp"/>
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_arrow_right"
                    app:tint="@android:color/darker_gray"/>
            </LinearLayout>
            <View style="@style/SettingsDivider" />

            <!-- Video Splitting Row -->
            <LinearLayout
                android:id="@+id/row_video_splitting"
                style="@style/SettingsGroupRow">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="16dp"
                    android:src="@drawable/ic_split_file"
                    android:tint="@android:color/darker_gray"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/row_video_splitting_title"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="?attr/colorHeading"/>
                <TextView
                    android:id="@+id/value_video_split_enabled"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/setting_disabled_msg"
                    android:textColor="@android:color/darker_gray"
                    android:textSize="13sp"/>
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_arrow_right"
                    android:tint="@android:color/darker_gray"/>
            </LinearLayout>
            <View style="@style/SettingsDivider" />

            <!-- Orientation Row (last without trailing divider) -->
            <LinearLayout
                android:id="@+id/row_orientation"
                style="@style/SettingsGroupRow">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="16dp"
                    android:src="@drawable/ic_screen_rotation"
                    android:tint="@android:color/darker_gray"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/row_orientation_title"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="?attr/colorHeading"/>
                <TextView
                    android:id="@+id/value_orientation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-"
                    android:textColor="@android:color/darker_gray"
                    android:textSize="13sp"/>
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_arrow_right"
                    android:tint="@android:color/darker_gray"/>
            </LinearLayout>
            <View style="@style/SettingsDivider" />

            <!-- Location Embed Row -->
            <LinearLayout
                android:id="@+id/row_location_embed"
                style="@style/SettingsGroupRow">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="16dp"
                    android:src="@drawable/ic_navigation"
                    android:tint="@android:color/darker_gray"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/video_setting_location_embed_title"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="?attr/colorHeading"/>
                <TextView
                    android:id="@+id/value_location_embed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-"
                    android:textColor="@android:color/darker_gray"
                    android:textSize="13sp"/>
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_arrow_right"
                    android:tint="@android:color/darker_gray"/>
            </LinearLayout>
            <!-- End group_card_video container -->
            </LinearLayout>
        </LinearLayout> <!-- outer padding container -->
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
